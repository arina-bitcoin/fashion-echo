[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .env,
    migrations,
    .pytest_cache,
    build,
    dist,
    *.egg-info

# Игнорируем некоторые ошибки для совместимости с Black
# E203: whitespace before ':'
# W503: line break before binary operator
# E501: line too long (handled by Black)

per-file-ignores =
    __init__.py:F401
    tests/*:F401,F811