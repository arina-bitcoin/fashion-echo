# dist/
# build/
# *.egg-info/













# ===========================================
# 1. СИСТЕМНЫЕ ФАЙЛЫ ОС
# ===========================================
.DS_Store          # macOS: настройки внешнего вида папок
Thumbs.db          # Windows: миниатюры изображений в папках
*.swp              # Vim: временные файлы при редактировании
*~                 # Резервные копии (Emacs, nano, другие редакторы)

# ===========================================
# 2. PYTHON
# ===========================================
__pycache__/       # Кэш байткода Python (.pyc файлы)
*.py[cod]          # Скомпилированные файлы Python (.pyc, .pyo, .pyd)
*$py.class         # Файлы классов Jython (Python на Java)

# ===========================================
# 3. ВИРТУАЛЬНОЕ ОКРУЖЕНИЕ PYTHON
# ===========================================
.venv/

# ===========================================
# 4. IDE И РЕДАКТОРЫ КОДА
# ===========================================
.idea/             # JetBrains (PyCharm, IntelliJ) - настройки проекта
.vscode/           # Visual Studio Code - настройки проекта
*.iml              # IntelliJ IDEA - файлы модулей

# ===========================================
# 5. БАЗА ДАННЫХ И ФАЙЛОВОЕ ХРАНИЛИЩЕ
# ===========================================
*.db               # SQLite базы данных
*.sqlite           # SQLite базы данных (альтернативное расширение)
*.sqlite3          # SQLite базы данных (версия 3)
db/
db/*.db            # Файлы .db внутри папки db
*.sql
*.dump
File_storage/      # Локальные загруженные файлы (изображения и т.д.)

# ===========================================
# 6. КОНФИГУРАЦИОННЫЕ ФАЙЛЫ И СЕКРЕТЫ
# ===========================================
.env               # Переменные окружения (самый важный!)
.env.local         # Локальные переопределения переменных окружения
.env.*.local       # Любые локальные файлы окружения
*.secret           # Файлы с секретами (пароли, ключи API)
*.key              # Криптографические ключи
*.pem              # SSL/TLS сертификаты и ключи

# ===========================================
# 7. ЛОГИ И ТЕСТЫ
# ===========================================
*.log              # Файлы логов приложения
logs/              # Папка с логами
.coverage          # Отчет о покрытии тестами (coverage.py)
htmlcov/           # HTML версия отчета о покрытии
.pytest_cache/     # Кэш pytest для ускорения повторных тестов

# ===========================================
# 8. СБОРКА И РАСПРЕДЕЛЕНИЕ
# ===========================================
dist/              # Собранные пакеты (python setup.py sdist bdist_wheel)
build/             # Временные файлы сборки
*.egg-info/        # Метаданные пакетов в формате egg

# ===========================================
# 9. ВРЕМЕННЫЕ ФАЙЛЫ
# ===========================================
*.tmp              # Временные файлы (расширение .tmp)
*.temp             # Временные файлы (расширение .temp)
temp/              # Папка для временных файлов
tmp/               # Альтернативная папка для временных файлов